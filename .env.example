# ── Root convenience .env.example ─────────────────────────────────────────
# Copy this to server/.env and client/.env (see each folder) or use as a
# reference. The server reads server/.env, the client reads client/.env.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://audix:audix@localhost:5432/audix

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# File storage: "local" (dev) or "s3" (R2 / S3-compatible in prod)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Public base URL used to build photo URLs for the local driver
PUBLIC_BASE_URL=http://localhost:4000

# S3 / R2 (only needed when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# CORS origin for the client dev server
CLIENT_ORIGIN=http://localhost:5173

# ── Client (client/.env) ──────────────────────────────────────────────────
# VITE_API_URL=http://localhost:4000
