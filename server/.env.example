NODE_ENV=development
PORT=4000

# The API REFUSES TO START when NODE_ENV=production and any of DATABASE_URL,
# JWT_SECRET or CLIENT_ORIGIN is still on a development default. See
# "Production configuration" in the README.
DATABASE_URL=postgres://audix:audix@localhost:5432/audix

# Anyone holding this value can mint a valid admin token. It must be a real
# random string of at least 32 characters in production — the placeholder
# below is rejected. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ── Photo storage ────────────────────────────────────────────────────────────
# Image FILES live in object storage; the database stores only the URL string.
# STORAGE_DRIVER=local  → dev fallback, writes to UPLOAD_DIR
# STORAGE_DRIVER=s3     → Cloudflare R2 / AWS S3 / any S3-compatible provider
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# Required when STORAGE_DRIVER=s3. Swapping provider is an env change only.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public base URL the bucket is served from (R2 public bucket or CDN domain)
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# Comma-separated list of origins allowed to call the API. '*' is accepted in
# development only — in production it is refused and the server will not start.
CLIENT_ORIGIN=http://localhost:5173
